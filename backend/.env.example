# ============================================================
#  ZUMVIA — Ortam Değişkenleri
#  Bu dosyayı ".env" olarak kopyalayın ve doldurun.
#  ASLA .env dosyasını git'e commit etmeyin.
# ============================================================

# --- ZORUNLU: Ana Şifreleme Anahtarı ---
# Üretmek için:  python -m app.core.crypto --generate-master-key
VQ_MASTER_KEY=

# --- ZORUNLU: JWT imza anahtarı ---
# Üretmek için:  python -c "import secrets;print(secrets.token_urlsafe(48))"
VQ_JWT_SECRET=

# --- Veritabanı ---
# SQLite (varsayılan, kurulum gerektirmez):
VQ_DATABASE_URL=sqlite:///./zumvia.db
# PostgreSQL örneği:
# VQ_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/zumvia

# --- Sunucu ---
VQ_HOST=0.0.0.0
VQ_PORT=8000
VQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Oturum ---
VQ_JWT_EXPIRE_MINUTES=10080     # 7 gün

# --- Global Güvenlik Kilidi ---
# true iken hiçbir kullanıcı GERÇEK PARA modunu açamaz (sadece paper trading).
VQ_FORCE_PAPER_ONLY=false

# --- Log ---
VQ_LOG_LEVEL=INFO
